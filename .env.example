# Copy to .env (git-ignored). Orchestra injects the same names as environment variables, so a
# .env is only for local runs. Only the MotherDuck token is required; everything else has a
# working default.

# --- where the raw data lands ----------------------------------------------------------------
# motherduck (default) or duckdb. duckdb writes a local file and needs no account: use it for
# tests and offline work.
# NGA_DESTINATION=motherduck

# MotherDuck access token (MotherDuck > Settings > Access tokens). No default. dlt, duckdb and
# dbt-duckdb all read it from this variable.
MOTHERDUCK_TOKEN=

# The MotherDuck database. `nga load` creates it if it does not exist; the datasets
# raw_noordkust, raw_open_meteo, raw_frankfurter and raw_nager_date become schemas inside it.
# NGA_MOTHERDUCK_DATABASE=next_gen_analytics

# Local DuckDB file used when NGA_DESTINATION=duckdb. Default: warehouse/nga.duckdb.
# NGA_WAREHOUSE=/absolute/path/to/nga.duckdb

# --- the synthetic shop and the reference-data window ----------------------------------------
# Every generated date is anchored here; pinned so runs are reproducible.
# NGA_AS_OF=2026-10-01

# Days of history before NGA_AS_OF that weather, exchange rates and holidays cover. The synthetic
# shop spans one year, so the default matches it.
# NGA_HISTORY_DAYS=365

# Currencies to fetch against EUR from Frankfurter.
# NGA_FX_SYMBOLS=GBP,CHF

# --- dbt ----------------------------------------------------------------------------------------
# dbt target: dev (schemas nga_dev_*) or prod (nga_staging, nga_intermediate, nga_marts).
# DBT_TARGET=dev
